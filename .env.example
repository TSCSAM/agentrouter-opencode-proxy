# Copy to .env for local runs. Every value is optional.
#
# Leave AGENTROUTER_API_KEY empty to relay the caller's key
# (this is the mode used when 9Router or OpenCode owns the key).
AGENTROUTER_API_KEY=

# Upstream base URL, no /v1 suffix.
AGENTROUTER_TARGET=https://agentrouter.org

# Relay mode: requests without a proxy token are accepted.
PROXY_ALLOW_ANONYMOUS=true
# Set a secret here only when PROXY_ALLOW_ANONYMOUS=false.
PROXY_AUTH_TOKEN=

# Model ids returned by GET /v1/models.
PROXY_MODEL_IDS=claude-opus-4-6,gpt-4o,gpt-4o-mini,deepseek-chat

# Tool and image requests are routed through AgentRouter /v1/responses.
# auto = only when the request needs tools or images, always = every request, off = never.
PROXY_RESPONSES_MODE=auto

LOG_LEVEL=info
